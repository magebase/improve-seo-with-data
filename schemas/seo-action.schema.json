{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEOActionRecord",
  "description": "Standardized schema for prioritized, evidence-backed SEO and conversion actions generated by the SEO Growth Operating System under the SEO Outcome Maximization Contract.",
  "type": "object",
  "required": [
    "action_id",
    "site",
    "target_urls",
    "opportunity_type",
    "page_level_action",
    "action_type",
    "diagnostic_classification",
    "direct_observation",
    "evidence_sources",
    "hypothesis",
    "proposed_action",
    "confidence",
    "effort",
    "priority_score",
    "status"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^seo_[a-z0-9_]+$",
      "description": "Unique identifier for the action item."
    },
    "direct_observation": {
      "type": "string",
      "description": "The exact empirical data observation that triggered this action (e.g. specific GSC query, impressions, CTR vs benchmark, crawl error code, or GA4 dropoff rate)."
    },
    "site": {
      "type": "string",
      "description": "Domain or property identifier (e.g., figiva.com, sc-domain:figiva.com)."
    },
    "page_group": {
      "type": "string",
      "description": "Logical page category or cluster (e.g., comparison_pages, calculators, landing_pages)."
    },
    "target_urls": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Canonical URLs targeted by this action."
    },
    "opportunity_type": {
      "type": "string",
      "enum": [
        "ctr_improvement",
        "ranking_opportunity",
        "conversion_leakage",
        "technical_risk",
        "content_expansion_or_consolidation",
        "unmet_search_demand"
      ],
      "description": "Which of the 6 core opportunity detectors generated this item."
    },
    "page_level_action": {
      "type": "string",
      "enum": [
        "improve_existing_page",
        "create_new_page",
        "improve_shared_template",
        "build_new_template",
        "consolidate_overlapping_pages",
        "no_change"
      ],
      "description": "The exact high-level page decision executed."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "title_optimization",
        "content_expansion",
        "internal_link_update",
        "technical_fix",
        "new_page_creation",
        "content_consolidation",
        "measurement_only"
      ],
      "description": "The specific implementation contract type for this action."
    },
    "diagnostic_classification": {
      "type": "string",
      "enum": [
        "state_1_discovered_or_crawled_not_indexed",
        "state_2_indexed_zero_impressions",
        "state_3_impressions_position_gt_30",
        "state_4_striking_distance_stage_2_pos_11_30",
        "state_5_striking_distance_stage_1_pos_4_10",
        "state_6_top_3_below_benchmark_ctr",
        "state_7_good_traffic_low_conversions",
        "state_8_multi_url_cannibalization"
      ],
      "description": "The diagnosed page-level search state in the 8-state decision tree."
    },
    "url_ownership": {
      "type": "object",
      "properties": {
        "query_cluster": { "type": "string", "description": "The specific query intent cluster." },
        "intended_url": { "type": "string", "description": "The designated owner URL for this query intent." },
        "actual_ranking_urls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "URLs that Google currently ranks for queries in this cluster."
        },
        "competing_urls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Internal URLs unintentionally splitting impressions or clicks."
        },
        "ownership_status": {
          "type": "string",
          "enum": ["exclusive_owner", "disputed_competing", "unowned_hub_landing", "new_cluster"],
          "description": "Current ownership state of the query cluster."
        }
      }
    },
    "content_evidence": {
      "type": "object",
      "description": "Structured evidence payload supporting factual and competitive claims for the page.",
      "properties": {
        "factual_sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Verified external/internal documentation, API specs, or pricing matrices."
        },
        "verified_claims": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Concrete verified facts (e.g. carrier names, latency benchmarks, exact fee structures)."
        },
        "unique_value_assertion": {
          "type": "string",
          "description": "Explanation of what original value or functional calculation this page provides over competing results."
        },
        "validation_timestamp": { "type": "string", "format": "date-time" },
        "quality_gate_passed": { "type": "boolean" }
      }
    },
    "indexing_funnel_stage": {
      "type": "string",
      "enum": [
        "published",
        "discovered_and_crawled",
        "eligible_and_indexed",
        "receiving_impressions",
        "generating_clicks_and_conversions"
      ],
      "default": "published",
      "description": "Current position in the live production indexing funnel."
    },
    "baseline_period": {
      "type": "object",
      "description": "Historical performance baseline prior to intervention.",
      "properties": {
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "ctr": { "type": "number" },
        "position": { "type": "number" },
        "conversions": { "type": "number" }
      }
    },
    "expected_value_breakdown": {
      "type": "object",
      "description": "EV(a) = P(success | a) * V(a) - Cost(a) - Risk(a)",
      "properties": {
        "p_success": { "type": "number", "minimum": 0, "maximum": 1 },
        "estimated_business_value": { "type": "number" },
        "cost": { "type": "number" },
        "risk": { "type": "number" },
        "expected_value": { "type": "number" },
        "formula": { "type": "string", "default": "EV(a) = P(success|a) * V(a) - Cost(a) - Risk(a)" }
      }
    },
    "evaluation_plan": {
      "type": "object",
      "properties": {
        "metric": { "type": "string", "description": "Primary metric used to evaluate success." },
        "eval_window_days": { "type": "integer", "default": 28 },
        "evaluation_method": {
          "type": "string",
          "enum": [
            "matched_url_cohort",
            "visitor_ab_test",
            "pre_post_segmented",
            "direct_technical_remediation"
          ]
        },
        "rollback_criteria": { "type": "string", "description": "Trigger condition for reverting change." }
      }
    },
    "decision_framework": {
      "type": "object",
      "properties": {
        "target_scope": { "type": "string", "description": "1. Which specific URL, cohort, or template changes?" },
        "action_type": { "type": "string", "description": "2. Should the action be an edit, new page, new template, consolidation, or fix?" },
        "supporting_evidence": { "type": "string", "description": "3. Which evidence supports that decision?" },
        "measurable_outcome": { "type": "string", "description": "4. What measurable outcome should improve?" },
        "scale_or_rollback_protocol": { "type": "string", "description": "5. How will you determine whether to scale, revise, or reverse?" }
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["gsc", "ga4", "posthog", "clarity", "cloudflare", "betterstack", "grafana"]
      },
      "minItems": 1,
      "description": "Authoritative telemetry sources providing evidence."
    },
    "evidence_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "observation"],
        "properties": {
          "source": { "type": "string" },
          "observation": { "type": "string" },
          "period": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": ["number", "string", "boolean", "null"] }
          }
        }
      }
    },
    "hypothesis": {
      "type": "string",
      "description": "Specific, falsifiable statement explaining why this intervention will yield incremental search clicks or business conversions."
    },
    "expected_impact": {
      "type": "object",
      "properties": {
        "incremental_clicks_low": { "type": ["number", "null"] },
        "incremental_clicks_high": { "type": ["number", "null"] },
        "incremental_conversions_low": { "type": ["number", "null"] },
        "incremental_conversions_high": { "type": ["number", "null"] },
        "expected_incremental_value": { "type": ["number", "null"] },
        "currency": { "type": "string", "default": "USD" }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Confidence in the causal explanation, data quality, and benchmark applicability."
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Implementation effort and engineering complexity."
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "low",
      "description": "Downside risk, blast radius, and reversibility."
    },
    "priority_score": {
      "type": "number",
      "description": "Effort-adjusted priority score: (Expected Value * Confidence) / (Effort + Risk)."
    },
    "proposed_action": {
      "type": "string",
      "description": "Concrete, actionable step to be executed."
    },
    "experiment_method": {
      "type": "string",
      "enum": [
        "matched_url_cohort",
        "visitor_ab_test",
        "historical_comparison",
        "direct_technical_remediation"
      ],
      "description": "Methodology to evaluate performance post-implementation."
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "validated",
        "approved",
        "implemented",
        "evaluated",
        "learned",
        "rejected"
      ],
      "default": "detected",
      "description": "Lifecycle state of the action item."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "implemented_at": { "type": ["string", "null"], "format": "date-time" },
    "evaluated_at": { "type": ["string", "null"], "format": "date-time" },
    "measured_outcome": {
      "type": "object",
      "properties": {
        "observed_click_change": { "type": ["number", "null"] },
        "observed_conversion_change": { "type": ["number", "null"] },
        "verdict": { "type": "string", "enum": ["win", "neutral", "loss", "inconclusive"] },
        "learnings": { "type": "string" }
      }
    }
  }
}
